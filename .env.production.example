# Production Environment Variables Template

# Gateway Configuration
GATEWAY_LISTEN=:4000

# Service Addresses (using internal Docker networking names)
AUTH_ADDR=auth-service:8080
WORKOUT_ADDR=workout-service:8081
EXERCISE_ADDR=exercise-service:8083
PROFILE_ADDR=profile-service:8084
ANALYTICS_ADDR=analytics-service:8085
NOTIFICATION_ADDR=notification-service:8086

# Database URLs
# Format: postgres://user:password@host:port/database?sslmode=verify-full
AUTH_DB_URL=postgres://zenx:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/zenx_auth
WORKOUT_DB_URL=postgres://zenx:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/zenx_workout
EXERCISE_DB_URL=postgres://zenx:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/zenx_exercise
PROFILE_DB_URL=postgres://zenx:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/zenx_profile
ANALYTICS_DB_URL=postgres://zenx:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/zenx_analytics
NOTIFICATION_DB_URL=postgres://zenx:REPLACE_WITH_SECURE_PASSWORD@postgres:5432/zenx_notification

# Messaging
NATS_URL=nats://nats:4222

# Secrets (Minimum 32 characters for production)
ACCESS_TOKEN_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING
REFRESH_TOKEN_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING

# Monitoring (Optional)
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
