# Example secrets file - DO NOT COMMIT THIS WITH REAL VALUES
# Create actual secrets using:
# kubectl create secret generic postgres-credentials --from-literal=auth-connection-string="postgres://..." --from-literal=workout-connection-string="postgres://..." ...
# kubectl create secret generic jwt-secrets --from-literal=access-token-secret="..." --from-literal=refresh-token-secret="..."

apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: zenx
type: Opaque
stringData:
  auth-connection-string: "postgres://zenx:password@postgres-primary:5432/zenx_auth?sslmode=disable"
  workout-connection-string: "postgres://zenx:password@postgres-primary:5432/zenx_workout?sslmode=disable"
  exercise-connection-string: "postgres://zenx:password@postgres-primary:5432/zenx_exercise?sslmode=disable"
  profile-connection-string: "postgres://zenx:password@postgres-primary:5432/zenx_profile?sslmode=disable"
  analytics-connection-string: "postgres://zenx:password@postgres-primary:5432/zenx_analytics?sslmode=disable"
  notification-connection-string: "postgres://zenx:password@postgres-primary:5432/zenx_notification?sslmode=disable"
---
apiVersion: v1
kind: Secret
metadata:
  name: jwt-secrets
  namespace: zenx
type: Opaque
stringData:
  access-token-secret: "change-me-to-secure-random-string"
  refresh-token-secret: "change-me-to-secure-random-string"


