4. API Gateway Implementation
4.1 GraphQL Federation Strategy
The API Gateway will implement GraphQL Federation using Apollo Federation or similar framework. Each microservice will expose its own GraphQL schema, and the gateway will federate these schemas into a unified API.
Key Features:

Single GraphQL endpoint for Flutter clients
Automatic schema stitching from microservices
Request batching and caching
Query complexity analysis
Rate limiting per user/IP

4.2 Authentication Flow
1. Client → Gateway: GraphQL mutation login(email, password)
2. Gateway → Auth Service: gRPC ValidateCredentials()
3. Auth Service → Gateway: JWT access token + refresh token
4. Gateway → Client: Return tokens
5. Client → Gateway: Subsequent requests with Authorization header
6. Gateway: Validate JWT, extract user context
7. Gateway → Services: Forward gRPC requests with user context
4.3 gRPC Communication
All inter-service communication uses gRPC with Protocol Buffers:
Benefits:

Type-safe contracts via .proto files
Binary protocol for performance
Built-in code generation
HTTP/2 multiplexing
Streaming support (for real-time features)

Example .proto structure:
protobufsyntax = "proto3";

package workout.v1;

service WorkoutService {
  rpc CreateWorkout(CreateWorkoutRequest) returns (CreateWorkoutResponse);
  rpc GetWorkout(GetWorkoutRequest) returns (GetWorkoutResponse);
  rpc ListWorkouts(ListWorkoutsRequest) returns (ListWorkoutsResponse);
  rpc StreamWorkout(StreamWorkoutRequest) returns (stream WorkoutUpdate);
}

message CreateWorkoutRequest {
  string user_id = 1;
  string name = 2;
  repeated Exercise exercises = 3;
}

message CreateWorkoutResponse {
  string workout_id = 1;
  int64 created_at = 2;
}

5. Data Architecture
5.1 PostgreSQL Schema Design
Core Entities:
sql-- Users (managed by Auth Service)
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email VARCHAR(255) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW()
);

-- User Profiles (managed by Profile Service)
CREATE TABLE user_profiles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    display_name VARCHAR(100),
    bio TEXT,
    avatar_url VARCHAR(500),
    date_of_birth DATE,
    gender VARCHAR(20),
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW()
);

-- Exercises (managed by Exercise Service)
CREATE TABLE exercises (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(200) NOT NULL,
    description TEXT,
    category VARCHAR(100),
    primary_muscle_group VARCHAR(100),
    secondary_muscle_groups TEXT[],
    equipment_required VARCHAR(100),
    difficulty_level VARCHAR(20),
    is_custom BOOLEAN DEFAULT FALSE,
    created_by UUID REFERENCES users(id),
    created_at TIMESTAMP DEFAULT NOW()
);

-- Workouts (managed by Workout Service)
CREATE TABLE workouts (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    name VARCHAR(200),
    notes TEXT,
    started_at TIMESTAMP,
    completed_at TIMESTAMP,
    duration_seconds INTEGER,
    total_volume_kg DECIMAL(10, 2),
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW()
);

-- Workout Exercises
CREATE TABLE workout_exercises (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    workout_id UUID REFERENCES workouts(id) ON DELETE CASCADE,
    exercise_id UUID REFERENCES exercises(id),
    order_index INTEGER NOT NULL,
    created_at TIMESTAMP DEFAULT NOW()
);

-- Sets
CREATE TABLE sets (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    workout_exercise_id UUID REFERENCES workout_exercises(id) ON DELETE CASCADE,
    set_number INTEGER NOT NULL,
    reps INTEGER,
    weight_kg DECIMAL(10, 2),
    rpe DECIMAL(3, 1), -- Rate of Perceived Exertion
    notes TEXT,
    completed BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT NOW()
);

-- Personal Records (managed by Analytics Service)
CREATE TABLE personal_records (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    exercise_id UUID REFERENCES exercises(id),
    record_type VARCHAR(50), -- '1RM', 'max_reps', 'max_volume'
    value DECIMAL(10, 2),
    achieved_at TIMESTAMP,
    workout_id UUID REFERENCES workouts(id),
    created_at TIMESTAMP DEFAULT NOW()
);

-- Body Measurements (managed by Profile Service)
CREATE TABLE body_measurements (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    measurement_date DATE NOT NULL,
    weight_kg DECIMAL(5, 2),
    body_fat_percentage DECIMAL(4, 2),
    muscle_mass_kg DECIMAL(5, 2),
    measurements JSONB, -- Flexible storage for various measurements
    created_at TIMESTAMP DEFAULT NOW()
);
